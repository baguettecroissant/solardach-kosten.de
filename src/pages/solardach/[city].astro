---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteWidget from '../../components/QuoteWidget.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQ from '../../components/FAQ.astro';
import { siteConfig } from '../../../site.config';
import { getAllCities, getNearbyCities, type City } from '../../lib/cities';
import localContentDe from '../../data/local-content-de.json';

export function getStaticPaths() {
  const cities = getAllCities();
  return cities.map(city => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props as { city: City };
const content = localContentDe[city.slug as keyof typeof localContentDe] || {
  intro: "",
  local_tip: "",
  market_data: "",
  faq_local: { question: "", answer: "" },
  sonnenpotenzial: ""
};

const nearbyCities = getNearbyCities(city, 8);

// TapTapHome AVR Check
const isHighAvr = siteConfig.taptaphome.highAvrPrefixes.some(prefix => city.zip.startsWith(prefix));

// Seed-based dynamic pricing for small tables
const seed = city.slug.split('').reduce((acc: number, c: string) => acc + c.charCodeAt(0), 0);
let multiplier = 1.0;
if (city.region === 'south') multiplier = 1.05;
else if (city.region === 'north') multiplier = 0.95;
else if (city.region === 'east') multiplier = 0.90;

const pMin = Math.round((5500 + (seed % 1000)) * multiplier / 100) * 100;
const pMid = Math.round((9000 + (seed % 1500)) * multiplier / 100) * 100;
const pMax = Math.round((14000 + (seed % 2500)) * multiplier / 100) * 100;
const pSp = Math.round((18000 + (seed % 3000)) * multiplier / 100) * 100;

const localFaq = [
  {
    q: `Was kostet eine Solaranlage in ${city.name} im Jahr 2026?`,
    a: `Für ein Einfamilienhaus in ${city.name} (${city.zip}) liegen die typischen Anschaffungskosten einer schlüsselfertigen Photovoltaikanlage ohne Speicher zwischen ${pMin.toLocaleString('de-DE')} € (klein, 4 kWp) und ${pMax.toLocaleString('de-DE')} € (groß, 12 kWp). Ein Komplettpaket inklusive einem 10 kWh Stromspeicher kostet in der Region im Schnitt zwischen ${pSp.toLocaleString('de-DE')} € und ${(pSp + 5000).toLocaleString('de-DE')} €.`
  },
  {
    q: content.faq_local.question || `Gibt es spezielle Förderungen für Photovoltaik in ${city.name}?`,
    a: content.faq_local.answer || `Ja, in ${city.name} profitieren Sie von der bundesweiten KfW-Förderung (zinsgünstige Kredite im Programm 270) sowie dem Wegfall der 19% Mehrwertsteuer. Je nach Bundesland ${city.bundesland} und lokalen Stadtwerken gibt es zusätzlich finanzielle Zuschüsse für Batteriespeicher.`
  },
  {
    q: `Wie viel Solarstrom erzeugt eine PV-Anlage in ${city.name}?`,
    a: `Dank ca. ${city.sonnenstunden} Sonnenstunden pro Jahr in der Region ${city.name} liefert eine optimal ausgerichtete Dachanlage mit 10 kWp Nennleistung einen jährlichen Ertrag von rund ${Math.round(city.sonnenstunden * 0.95 * 10).toLocaleString('de-DE')} kWh klimafreundlichem Strom.`
  },
  {
    q: `Wie finde ich einen guten Solarteur in ${city.name}?`,
    a: `Durch unseren kostenlosen Vermittlungsservice erhalten Sie bis zu 3 Angebote von geprüften Solar-Fachbetrieben aus der Region ${city.bundesland}, die auf die Gegebenheiten in ${city.name} spezialisiert sind. Vergleichen Sie Preise, Garantien und Montagezeiten bequem von zu Hause aus.`
  }
];

const title = siteConfig.niche.seoTitleTemplate.replace('{city}', city.name).replace('{zip}', city.zip);
const description = siteConfig.niche.metaDescTemplate.replace('{city}', city.name).replace('{zip}', city.zip).replace('{priceMin}', pMid.toLocaleString('de-DE')).replace('{priceMax}', pSp.toLocaleString('de-DE'));

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Installation Solaranlage " + city.name,
    "description": description,
    "areaServed": { "@type": "City", "name": city.name, "postalCode": city.zip },
    "provider": { "@type": "Organization", "name": siteConfig.name },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": localFaq.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Startseite", "item": "https://" + siteConfig.domain },
      { "@type": "ListItem", "position": 2, "name": "Städte", "item": "https://" + siteConfig.domain + "/solardach" },
      { "@type": "ListItem", "position": 3, "name": city.name },
    ]
  }
];
---

<BaseLayout title={title} description={description} canonical={"/solardach/" + city.slug} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <section class="gradient-hero text-white py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Breadcrumbs items={[
        { label: "Städte", href: "/solardach" },
        { label: city.bundesland, href: "/solardach" },
        { label: city.name, href: "/solardach/" + city.slug },
      ]} />

      <div class="grid lg:grid-cols-5 gap-10 items-start mt-6">
        <div class="lg:col-span-3">
          {isHighAvr && (
            <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-500/30 px-3 py-1.5 rounded-full text-xs text-amber-300 mb-4 sun-pulse font-semibold">
              ☀️ Top-PV-Region: Lokale Fachbetriebe aktiv
            </div>
          )}

          <h1 class="text-2xl md:text-4xl font-extrabold leading-tight mb-4 font-heading">
            Solaranlage in {city.name} ({city.zip})
          </h1>
          <p class="text-blue-100 leading-relaxed mb-6 max-w-xl text-sm md:text-base">
            Kosten, Förderung und Angebote für Ihr Solardach in {city.name}. Vergleichen Sie bis zu 3 Angebote von geprüften Solar-Fachbetrieben aus der Region.
          </p>

          <div class="flex flex-wrap gap-3 mb-6">
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">📍 PLZ {city.zip}</span>
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">☀️ {city.sonnenstunden} Sonnenstunden</span>
            <span class="bg-white/10 backdrop-blur-sm border border-white/20 px-3 py-1.5 rounded-full text-xs">✓ 0% Umsatzsteuer</span>
          </div>

          <a href="#devis-form" class="inline-block cta-gradient text-white font-bold px-6 py-3.5 rounded-xl transition-all shadow-lg text-sm md:text-base">
            ☀️ Angebote in {city.name} vergleichen →
          </a>
        </div>

        <div class="lg:col-span-2">
          <QuoteWidget keyword={"Solaranlage " + city.name} />
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Block 1: Local Intro -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-6">
      <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-2 font-heading">🏠 Photovoltaikanlage planen in {city.name}</h2>
      
      <div class="text-gray-700 space-y-4 leading-relaxed text-sm md:text-base">
        <p>{content.intro}</p>
        
        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">💡 Regionaler Expertentipp</h3>
        <p set:html={content.local_tip} />

        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">📊 Solarmarkt & Installateure</h3>
        <p>{content.market_data}</p>

        <h3 class="text-lg font-bold text-gray-900 pt-2 font-heading">☀️ Sonnenpotenzial & Solarertrag</h3>
        <p>{content.sonnenpotenzial}</p>
      </div>
    </section>

    <!-- Block 2: Price Range -->
    <section class="bg-gradient-to-r from-blue-50 to-amber-50/30 rounded-2xl border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">💰 Kosten für Solaranlagen in {city.name} ({city.zip})</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-gray-500 mb-1">Klein (4 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMin.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-amber-300 ring-2 ring-amber-100">
          <span class="block text-xs text-amber-600 font-semibold mb-1">Mittel (8 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMid.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-gray-500 mb-1">Groß (12 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-gray-900 font-data">{pMax.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Ohne Speicher</span>
        </div>
        <div class="bg-white rounded-xl p-4 text-center border border-gray-200">
          <span class="block text-xs text-gray-500 mb-1">PV + Speicher (10 kWp)</span>
          <span class="block text-base md:text-lg font-bold text-amber-600 font-data">{pSp.toLocaleString('de-DE')} €</span>
          <span class="block text-[10px] text-gray-500">Inkl. 10 kWh Speicher</span>
        </div>
      </div>
      <p class="text-xs text-gray-500">
        * Richtwerte für Brutto-Komplettpreise im Jahr 2026 inklusive Montage, Netzanschluss und Anmeldung. Seit 2023 gilt 0% Umsatzsteuer auf Solaranlagen in Deutschland.
      </p>
    </section>

    <!-- Block 3: Wirtschaftlichkeit -->
    <section class="info-card rounded-xl p-6">
      <h3 class="text-lg font-bold text-blue-900 mb-3 font-heading">⚡ Netzstrom vs. Solarstrom in {city.name}</h3>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl p-4 border border-red-100">
          <h4 class="font-bold text-red-700 text-sm mb-2">🔴 Strombezug vom Netz</h4>
          <p class="font-data text-lg font-bold text-red-600">ca. 35 - 38 ct / kWh</p>
          <p class="text-xs text-gray-500">Steigende Preise, fossile Abhängigkeit</p>
        </div>
        <div class="bg-white rounded-xl p-4 border border-green-100">
          <h4 class="font-bold text-green-700 text-sm mb-2">🟢 Strom vom eigenen Dach</h4>
          <p class="font-data text-lg font-bold text-green-600">ca. 8 - 10 ct / kWh</p>
          <p class="text-xs text-gray-500">Garantierter Preis über 25+ Jahre</p>
        </div>
      </div>
      <p class="text-xs text-blue-900/80 mt-3 font-semibold">
        Durch die hohe Differenz von rund 27 Cent je Kilowattstunde amortisiert sich ein Solarsystem in {city.name} typischerweise nach ca. 8 bis 11 Jahren.
      </p>
    </section>

    <!-- Map Section (Leaflet JS + OpenStreetMap) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8 space-y-4">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-1 font-heading">🗺️ Solarpotenzial-Karte für {city.name}</h2>
      <p class="text-sm text-gray-600">
        Die geografische Analyse zeigt das solare Einzugsgebiet für {city.name} ({city.zip}) im Bundesland {city.bundesland}. Mit {city.sonnenstunden} Sonnenstunden pro Jahr bietet Ihr Standort erstklassige Einstrahlungswerte für eine rentable Eigenversorgung.
      </p>
      
      <div id="solar-map" class="h-64 md:h-80 w-full rounded-xl border border-gray-200 shadow-inner z-10"></div>
      <p class="text-[11px] text-gray-400 text-center">
        Kartendaten © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener nofollow" class="underline">OpenStreetMap</a>-Mitwirkende.
      </p>

      <script is:inline define:vars={{ lat: city.lat, lng: city.lng, cityName: city.name, zip: city.zip }}>
        document.addEventListener('DOMContentLoaded', () => {
          if (typeof L !== 'undefined' && document.getElementById('solar-map')) {
            const map = L.map('solar-map', { scrollWheelZoom: false }).setView([lat, lng], 12);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
              maxZoom: 19,
              attribution: '© OpenStreetMap'
            }).addTo(map);
            
            // Solar-themed circle marker (avoid broken default PNG marker assets)
            L.circleMarker([lat, lng], {
              radius: 10,
              fillColor: '#FF6F00',
              color: '#FFFFFF',
              weight: 2.5,
              opacity: 1,
              fillOpacity: 0.95
            }).addTo(map)
              .bindPopup(`<b>Solarpotenzial in ${cityName}</b><br>PLZ: ${zip}<br>Ertrag: ~980 kWh/kWp`)
              .openPopup();
          }
        });
      </script>
    </section>

    <!-- Block 4: Förderungen -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">🏛️ Staatliche Förderung & Steuerfreiheit</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">0% Umsatzsteuersatz</h3>
          <p class="text-xs text-gray-600 mt-2">Dank der gesetzlichen Regelung entfällt die Mehrwertsteuer auf PV-Anlagen und Speicher komplett. Sie sparen direkt 19% Anschaffungskosten.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">KfW-Förderkredit 270</h3>
          <p class="text-xs text-gray-600 mt-2">Die Kreditanstalt für Wiederaufbau (KfW) bietet zinsgünstige Darlehen für Photovoltaik, Speicher und Zählerplatz-Modernisierung an.</p>
        </div>
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
          <h3 class="font-bold text-gray-900 text-sm">Einspeisevergütung</h3>
          <p class="text-xs text-gray-600 mt-2">Für überschüssigen Solarstrom, den Sie ins Netz einspeisen, erhalten Sie eine über 20 Jahre gesetzlich garantierte Vergütung (ca. 8,0 ct/kWh).</p>
        </div>
      </div>
      <div class="text-center mt-4">
        <a href="/ratgeber/photovoltaik-foerderung-2026" class="text-amber-600 hover:text-amber-700 text-sm font-semibold transition-colors">
          Ausführlicher Ratgeber zur Solarförderung →
        </a>
      </div>
    </section>

    <!-- Block 5: FAQ locale -->
    <FAQ items={localFaq} cityName={city.name} />

    <!-- Block 6: Nearby cities -->
    {nearbyCities.length > 0 && (
      <section>
        <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📍 Solaranbieter in der Nachbarschaft</h2>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {nearbyCities.map((nc) => (
            <a href={"/solardach/" + nc.slug} class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
              <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm block">{nc.name}</span>
              <span class="text-xs text-gray-500">{nc.zip}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Block 7: Guides recommandés -->
    <section class="bg-white rounded-2xl shadow-sm border border-gray-200 p-6 md:p-8">
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">📚 Relevante Solar-Ratgeber</h2>
      <div class="grid sm:grid-cols-3 gap-4">
        <a href="/ratgeber/solaranlage-kosten-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">💰</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">Photovoltaik Kosten 2026</span>
          <span class="text-xs text-gray-600 mt-1 block">Brutto-Preise pro kWp und Speicher</span>
        </a>
        <a href="/ratgeber/photovoltaik-foerderung-2026" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">🏛️</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">Solar-Förderung im Überblick</span>
          <span class="text-xs text-gray-600 mt-1 block">KfW-Zuschuss und steuerliche Vorteile</span>
        </a>
        <a href="/ratgeber/solaranlage-mit-speicher" class="bg-gray-50 rounded-xl p-4 border border-gray-200 hover:border-amber-400 hover:shadow-md transition-all group">
          <span class="text-lg block mb-1">🔋</span>
          <span class="font-bold text-gray-900 group-hover:text-amber-600 text-sm block">Lohnt sich ein Stromspeicher?</span>
          <span class="text-xs text-gray-600 mt-1 block">Eigenverbrauch steigern und Kosten senken</span>
        </a>
      </div>
    </section>

    <!-- Block 8: Hersteller -->
    <section>
      <h2 class="text-lg md:text-xl font-bold text-gray-900 mb-4 font-heading">🏆 Führende Modulhersteller & Zubehör</h2>
      <div class="grid grid-cols-2 sm:grid-cols-6 gap-3">
        <a href="/hersteller/meyer-burger" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">Meyer Burger</span>
          <span class="block text-[10px] text-gray-500">🇨🇭 Schweiz/DE</span>
        </a>
        <a href="/hersteller/solarwatt" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">Solarwatt</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Deutschland</span>
        </a>
        <a href="/hersteller/sma-solar" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">SMA Solar</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Wechselrichter</span>
        </a>
        <a href="/hersteller/fronius" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">Fronius</span>
          <span class="block text-[10px] text-gray-500">🇦🇹 Österreich</span>
        </a>
        <a href="/hersteller/senec" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">Senec</span>
          <span class="block text-[10px] text-gray-500">🇩🇪 Stromspeicher</span>
        </a>
        <a href="/hersteller/jinkosolar" class="bg-white border border-gray-200 rounded-xl px-4 py-3 hover:border-amber-400 hover:shadow-md transition-all group text-center card-hover">
          <span class="font-semibold text-gray-900 group-hover:text-amber-600 text-xs md:text-sm">JinkoSolar</span>
          <span class="block text-[10px] text-gray-500">🇨🇳 Weltmarktführer</span>
        </a>
      </div>
    </section>

    <!-- Block 10: Final CTA -->
    <section>
      <div class="cta-gradient rounded-2xl p-8 text-center text-white">
        <h2 class="text-xl md:text-2xl font-bold mb-3 font-heading">Solarangebote in {city.name} vergleichen</h2>
        <p class="text-amber-100 mb-5 text-xs md:text-sm">Vergleichen Sie kostenlose Angebote regionaler Fachbetriebe • 100% unverbindlich</p>
        <a href="/angebot" class="inline-block bg-white text-amber-600 font-bold px-8 py-3.5 rounded-xl hover:bg-gray-100 transition-colors shadow-lg text-sm md:text-base">
          ☀️ Angebote anfordern
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
